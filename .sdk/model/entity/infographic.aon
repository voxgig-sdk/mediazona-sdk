# Entity: infographic

main: kit: entity: infographic: {

  alias: field: {}

  fields: [
    {
      format: "uri"
      name: "url"
      req: false
      short: "URL to the infographic resource"
      type: "`$STRING`"
    }
  ]

  name: "infographic"
  op: {
    list: {
      name: "list"
      points: [
        {
          args: {
            query: [
              {
                example: "cae8add5"
                kind: "query"
                name: "cachebuster"
                orig: "cachebuster"
                reqd: false
                type: "`$STRING`"
              }
            ]
          }
          method: "GET"
          orig: "/infographics/g200w/urls.json.gz"
          segments: [
            {
              lit: "infographics"
            }
            {
              lit: "g200w"
            }
            {
              lit: "urls.json.gz"
            }
          ]
          select: {
            exist: [
              "cachebuster"
            ]
          }
          transform: {
            req: "`reqdata`"
            res: "`body.urls`"
          }
        }
      ]
    }
  }



}
